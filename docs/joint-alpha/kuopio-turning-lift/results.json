  "measurement": {
    "target": "Change in the midpoint of two optical marks on the right wrist over 100 ms.",
    "window_optical_frames": 25,
    "optical_hz": 100,
    "analog_hz": 2400,
    "current_analog_block_offset_optical_frames": 2,
    "earlier_control_shift_ms": 1000,
    "axis_order": [
      "native laboratory X",
      "native laboratory Y",
      "native laboratory Z"
    ],
    "aggregation": "Average each person's error across their eligible forecast windows, then give each person equal weight."
  },
  "fitting": {
    "people": 7,
    "examples_per_mixture": 1986,
    "examples_from_each_task_in_mixed_fit": 993,
    "case_selection": "Use the largest even count available to both tasks for each fitting person. Rank each person's native issue numbers within a task by SHA-256 of kuopio-task-transfer-v1|person|task|native-issue-frame. The mixed fit uses the first half of each ranked selection.",
    "task_labels": {
      "lift_only": "Straight lifts",
      "rotation_only": "Turning lifts",
      "mixed_tasks": "Both lifts"
    },
    "model_labels": {
      "ridge": "Linear model (ridge)",
      "attention": "Attention model"
    },
    "sensor_labels": {
      "motion": "Wrists",
      "motion_and_emg": "Wrists and muscle readings",
      "motion_and_ground_force": "Wrists and floor forces",
      "all_current": "Wrists, floor forces and muscle readings",
      "earlier_emg": "Wrists and floor forces, with muscle readings from one second earlier",
      "earlier_emg_and_ground_force": "Wrists, with floor forces and muscle readings from one second earlier"
    },
    "model_inputs": "18 values and 18 availability flags at each of 25 steps. Use means and scales learned on fitting people only.",
    "linear_model": "One regularized linear regression for each sensor combination. Penalty 0.1 with an unpenalized intercept on standardized targets.",
    "attention_model": "9,859 parameters. One attention block with width 32, four heads and a 64-wide feed-forward layer. Use 40 AdamW epochs, learning rate 0.001, weight decay 0.01, and mean predictions across seeds 17, 29 and 41.",
    "shared_controls": {
      "persistence": "Keep the wrist at its last position",
      "velocity": "Continue the last 50 ms of motion at the same speed and direction"
    }
  },
  "confirmation": {
    "task": "Lifting a 12 kg box while turning the torso.",
