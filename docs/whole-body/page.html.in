main.activity-map{width:auto;height:auto;max-height:none;overflow:visible;border:none;border-radius:0}
main h1{font-size:clamp(1.9rem,5.6vw,3.4rem);letter-spacing:-.04em;line-height:1.06;margin:.6rem 0 1.3rem}
