  "integrity_manifest": {
    "url": "https://zenodo.org/api/records/19065545/files/trial_integrity_manifest.csv/content",
    "md5": "0df75829b3f53e78b0c9bb6b495bdf51",
    "sha256": "58480537843f63884817d5ff6a3cb3a5e29a9b88e5850a037cd632affca83de6",
    "bytes": 376,
    "checked_selection": "No development trial 02 or 03 in the four selected Experiment 2 sessions is listed as missing or truncated."
  },
  "measures": {
    "surface_electricity": "Two 32-electrode surface grids, 8 by 4, 10 mm spacing. Right scapula reference. The authors describe placement over C4 and L2. Raw values are in microvolts. Surface voltages can include contributions from muscle, cardiac activity and movement.",
    "orientation": "Back-mounted BNO055 fusion output. Nominal 100 Hz internal updates, repeated on the shared 2000 Hz storage grid. Four components stored in arbitrary units. Relative unsigned device rotation can be computed from normalized quaternion endpoints in degrees.",
    "processing": "The authors provide quality masks and preprocessed arrays. Raw past data are the input to a prospective analysis. Masks and preprocessed arrays may use information after the prediction cutoff.",
    "scope": "Placement gives the anatomical region of a surface measurement. The shared storage clock leaves device lag uncalibrated. Neural generators, joint angles, position, walking speed and foot contacts remain undetermined."
  },
  "cohort": "development",
