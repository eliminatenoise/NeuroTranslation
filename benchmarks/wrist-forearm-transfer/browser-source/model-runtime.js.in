/* Generated by build_model.py from the released WristMotion forearm benchmark. */
(() => {
  "use strict";

  const fitted = /* RELEASED_MODEL */;
  const synthetic = /* RELEASED_SYNTHETIC */;
  const examples = /* ILLUSTRATIVE_WINDOWS */;
  const pins = Object.freeze(/* SOURCE_PINS */);

  const offsets = Object.freeze([384, 512, 640, 768, 896, 1024]);
  const axisOrder = Object.freeze(["extension", "radial_deviation"]);
  const methods = Object.freeze(["frozen_motion", "motion_correction", "motion_emg_correction"]);
  const sampleRateHz = 512;
  const binsPerWindow = 16;
  const axes = 2;
  const emgPairs = 4;
  const seeds = [17, 29, 43];
  const convolutionLayers = [[2, 16, 3], [16, 16, 3]];
  const denseLayers = [[200, 32, 1], [32, 2, 1]];
  let model;

  function vector(values, count, description, minimum = -Infinity) {
    if (!Array.isArray(values) || values.length !== count) {
      throw new TypeError(`${description} needs ${count} values.`);
    }
    const copy = new Array(count);
    for (let i = 0; i < count; i += 1) {
      const value = values[i];
      if (!Number.isFinite(value) || value < minimum) {
        throw new TypeError(`${description} contains an invalid number.`);
      }
      copy[i] = value;
    }
    return copy;
  }

  function matrix(rows, height, width, description, minimum = -Infinity) {
    if (!Array.isArray(rows) || rows.length !== height) {
      throw new TypeError(`${description} needs ${height} rows.`);
    }
    return Array.from({ length: height }, (_, i) => vector(rows[i], width, description, minimum));
  }

  function readWindow(input, requiredOffset) {
    if (!input || typeof input !== "object" || Array.isArray(input)) {
      throw new TypeError("Choose a forecast window.");
    }
    const offset = input.target_offset_ticks;
    if (!offsets.includes(offset) || (requiredOffset !== undefined && offset !== requiredOffset)) {
      throw new RangeError("Use the supported times after the cue in their original order.");
    }
    return {
      offset,
      anchor: vector(input.anchor_deg, axes, "Anchor angles"),
      motion: matrix(input.motion_bins_deg_relative_to_anchor, binsPerWindow, axes, "Motion bins"),
      emg: matrix(input.emg_differential_rms_uv, binsPerWindow, emgPairs, "EMG amplitude bins", 0).flat(),
    };
  }

  function scaler(parameters, name, length) {
    const center = vector(parameters[`${name}_center`], length, `${name} centres`);
    const scale = vector(parameters[`${name}_scale`], length, `${name} scales`);
    if (scale.some(width => width <= 0)) throw new Error("The model has an invalid scale.");
    return { center, scale };
  }

  function decodeNetwork(encoded) {
    const bytes = Uint8Array.from(atob(encoded), character => character.charCodeAt(0));
    const view = new DataView(bytes.buffer);
    const layouts = [...convolutionLayers, ...denseLayers];
    const count = layouts.reduce((total, [inputs, outputs, kernel]) => total + outputs * (inputs * kernel + 1), 0);
    if (bytes.length !== count * Float32Array.BYTES_PER_ELEMENT) {
      throw new Error("The motion network has an unexpected weight count.");
    }
    const weights = new Float32Array(count);
    for (let i = 0; i < count; i += 1) {
      const value = view.getFloat32(i * Float32Array.BYTES_PER_ELEMENT, true);
      if (!Number.isFinite(value)) throw new Error("The motion network has an invalid weight.");
      weights[i] = value;
    }
    let start = 0;
    return layouts.map(([inputs, outputs, kernel]) => {
      const end = start + inputs * outputs * kernel;
      const layer = { weights: weights.subarray(start, end), biases: weights.subarray(end, end + outputs) };
      start = end + outputs;
      return layer;
    });
  }

  function loadModel() {
    if (model) return model;
    if (fitted.schema !== "wrist_motion_forearm_correction.v1"
        || fitted.seed_order.length !== seeds.length
        || !seeds.every((seed, i) => fitted.seed_order[i] === seed)
        || fitted.parent_motion_temporal_sha256 !== pins.parentMotionSealSha256
        || fitted.transfer_train_sha256 !== pins.transferTrainSealSha256
        || fitted.design_sha256 !== pins.designSha256
        || synthetic.invented_inputs !== true || synthetic.cases.length !== 12) {
      throw new Error("The bundled model or examples do not match this study.");
    }
    const normalization = fitted.frozen_normalization;
    const corrections = fitted.correction_parameters;
    const motionLength = seeds.length * denseLayers[0][1] + axes;
    const emgLength = binsPerWindow * emgPairs;
    model = {
      networks: seeds.map(seed => decodeNetwork(fitted.models[seed])),
      bins: scaler(normalization, "bins", axes),
      anchor: scaler(normalization, "anchor", axes),
      residual: scaler(normalization, "residual", axes),
      motion: scaler(corrections, "motion", motionLength),
      emg: scaler(corrections, "emg", emgLength),
      motionHead: matrix(corrections.motion_coefficients, motionLength + offsets.length, axes, "Motion coefficients"),
      emgHead: matrix(corrections.emg_coefficients, motionLength + emgLength + offsets.length, axes, "EMG coefficients"),
    };
    return model;
  }

  function finite(value) {
    if (!Number.isFinite(value)) throw new RangeError("These inputs exceed the model’s numeric range.");
    return value;
  }

  function standardize(values, { center, scale }) {
    return values.map((value, i) => finite((value - center[i]) / scale[i]));
  }

  // The released Python evaluator accumulates in double precision, then rounds
  // each activation to float32. Check range before ReLU can hide an overflow.
  function activation(value, relu = false) {
    return finite(Math.fround(relu ? Math.max(finite(value), 0) : value));
  }

  function convolveRelu(signal, channelCount, sampleCount, { weights, biases }) {
    const outputSize = sampleCount - 2;
    const result = new Float32Array(biases.length * outputSize);
    for (let output = 0; output < biases.length; output += 1) {
      for (let sample = 0; sample < outputSize; sample += 1) {
        let value = biases[output];
        for (let channel = 0; channel < channelCount; channel += 1) {
          const start = channel * sampleCount + sample;
          const kernel = (output * channelCount + channel) * 3;
          value += signal[start] * weights[kernel];
          value += signal[start + 1] * weights[kernel + 1];
          value += signal[start + 2] * weights[kernel + 2];
        }
        result[output * outputSize + sample] = activation(value, true);
      }
    }
    return result;
  }

  function affine(features, { weights, biases }, relu = false) {
    const result = new Float32Array(biases.length);
    for (let unit = 0; unit < biases.length; unit += 1) {
      const start = unit * features.length;
      let sum = 0;
      for (let i = 0; i < features.length; i += 1) sum += features[i] * weights[start + i];
      result[unit] = activation(biases[unit] + sum, relu);
    }
    return result;
  }

  function correction(base, features, weights) {
    return base.map((degrees, axis) => {
      // Neumaier compensated summation keeps the additive heads close to math.fsum.
      let sum = 0;
      let remainder = 0;
      for (let i = 0; i < features.length; i += 1) {
        const product = finite(features[i] * weights[i][axis]);
        const total = finite(sum + product);
        remainder += Math.abs(sum) >= Math.abs(product) ? (sum - total) + product : (product - total) + sum;
        sum = total;
      }
      return finite(degrees + (sum + remainder));
    });
  }

  function predict({ offset, anchor, motion, emg }) {
    const state = loadModel();
    const timing = offsets.map(target => Number(offset === target));
    const signal = new Float32Array(axes * binsPerWindow);
    for (let axis = 0; axis < axes; axis += 1) {
      for (let bin = 0; bin < binsPerWindow; bin += 1) {
        signal[axis * binsPerWindow + bin] = activation((motion[bin][axis] - state.bins.center[axis]) / state.bins.scale[axis]);
      }
    }
    const auxiliary = standardize(anchor, state.anchor).map(value => activation(value)).concat(timing);
    const latent = [];
    const base = [0, 0];
    for (const [conv1, conv2, dense, output] of state.networks) {
      const first = convolveRelu(signal, axes, binsPerWindow, conv1);
      const second = convolveRelu(first, convolutionLayers[0][1], binsPerWindow - 2, conv2);
      const features = new Float32Array(second.length + auxiliary.length);
      features.set(second);
      features.set(auxiliary, second.length);
      const hidden = affine(features, dense, true);
      const residual = affine(hidden, output);
      latent.push(...hidden);
      for (let axis = 0; axis < axes; axis += 1) {
        base[axis] += anchor[axis] + residual[axis] * state.residual.scale[axis] + state.residual.center[axis];
      }
    }
    for (let axis = 0; axis < axes; axis += 1) base[axis] = finite(base[axis] / seeds.length);
    const motionFeatures = standardize(latent.concat(anchor), state.motion);
    const emgFeatures = standardize(emg, state.emg);
    return {
      frozen_motion: base,
      motion_correction: correction(base, motionFeatures.concat(timing), state.motionHead),
      motion_emg_correction: correction(base, motionFeatures.concat(emgFeatures, timing), state.emgHead),
    };
  }

  function predictWindow(input) {
    return predict(readWindow(input));
  }

  function predictTrial(inputs) {
    if (!Array.isArray(inputs) || inputs.length !== offsets.length) {
      throw new TypeError("A trial needs all six forecast windows.");
    }
    return offsets.map((offset, i) => ({
      target_offset_ticks: offset,
      target_offset_seconds: offset / sampleRateHz,
      ...predict(readWindow(inputs[i], offset)),
    }));
  }

  // Neither entry point reads an archive or attests to the origin of its inputs.
  Object.defineProperty(globalThis, "WristForearmModel", {
    value: Object.freeze({
      offsets, methods, axisOrder, sampleRateHz, pins, predictWindow, predictTrial,
      syntheticCases: () => structuredClone(synthetic.cases),
      exampleWindows: () => structuredClone(examples),
    }),
  });
})();
