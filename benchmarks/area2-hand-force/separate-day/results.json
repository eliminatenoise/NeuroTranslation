  "method": {
    "issue_window_ms": 200,
    "predict_after_ms": 100,
    "issue_step_ms": 320,
    "inputs": "Ten positions relative to measured position at issue, ten xyz force samples at the same bin starts, and ten half-open 20 ms bins of sorted area 2 event counts. In the receiver sum the two complete archived 10 ms rows in each bin. Use only verified sorted neural rows. No receiver electrode identities are transferred.",
    "neural_pooling": "For each time bin, summarize across reported sorted units using mean and population standard deviation of log1p(count) and fraction of units with a positive count. Missing units are not added as silent dimensions. Differences in sorting and observation coverage remain part of the archive shift.",
    "two_fitted_forecasts": "Matched FP64 ridge heads use motion and force, and motion/force with pooled Area 2. Fit normalization on 218 trial heads only, select from 0.0001, 0.001, 0.01, 0.1, 1.0, 10.0 using mean endpoint error in the 72 config trials. Preserve both fixed heads.",
    "blend_rule": "Fit a shared sigmoid weight for the two fixed heads on the 72 configuration trials. Four features available at issue are log1p of speed proxy (last 20 ms displacement in mm), log1p of the change of force magnitude proxy (distance between earliest and latest archived force), log1p of sensor-head forecast length, and log1p of the norm of disagreement between heads. Normalize from the configuration rows with equal trial weight, clip to [-5,5], ridge penalty 0.05 mm applied to gate slopes only and smooth Euclidean error with 0.01 mm floor. Try intercept initializations -1, 0, 1; take the smallest penalized objective. Fit when independent receiving fields are still held.",
    "fixed_neural_weight": 0.3573845152401196,
    "adaptive_neural_weight_percentiles_5_50_95": [
      0.3441618640243105,
      0.36807312488728344,
      0.4368038935974539
    ],
    "resampling": "4000 paired whole-trial bootstrap draws. Group sizes count their contributing trials. Positive gains are reductions in error.",
    "measures_in_order": [
      "endpoint error in mm",
      "displacement length error in mm"
    ]
